# ==============================================================================
# Sovereign AI Workbench — Environment Configuration Example
# Copy to .env for local runtime configuration
# ==============================================================================

# Server & Network Isolation
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOW_LAN=false

# Ollama Local Service
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1

# Strict Offline Enforcement Flags
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=False
DO_NOT_TRACK=1
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Paths & Storage
MODEL_REGISTRY_PATH=models/registry.yaml
DATA_DIR=./data
LOG_DIR=./logs
ALLOWED_INPUT_DIRS=data/incoming,data/knowledge_base
ALLOWED_OUTPUT_DIRS=data/outputs
SECRET_KEY_FILE=data/secrets/session.key

# Runtime Limits & Safeguards
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=200
MAX_AGENT_RETRIES=3
MAX_TOOL_STEPS=25
MODEL_CALL_TIMEOUT_S=180
TOOL_TIMEOUT_S=120
SANDBOX_TIMEOUT_S=30

# Authentication & Sessions
SESSION_TTL_MIN=60
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=10

# Security Auditing
ENABLE_ACTIVE_EGRESS_PROBE=false
